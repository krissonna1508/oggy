#!name=Locket Custom Edition
#!desc=Crack By if.alex2006 | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/krissonna1508/oggy/main/locket.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by alex2k6)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/krissonna1508/oggy/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 25/05/1111 (by alex2k6)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/krissonna1508/oggy/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60
